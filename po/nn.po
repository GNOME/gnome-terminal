#| msgid "Terminal"
msgid "gnome-terminal"
msgstr "gnome-terminal"

#: data/org.gnome.Terminal.Nautilus.metainfo.xml.in:34
msgid "org.gnome.Terminal.Nautilus"
msgstr "org.gnome.Terminal.Nautilus"

#: data/org.gnome.Terminal.Nautilus.metainfo.xml.in:35
msgid "org.gnome.Nautilus.desktop"
msgstr "org.gnome.Nautilus.desktop"

#: data/org.gnome.Terminal.Nautilus.metainfo.xml.in:38
msgid "Terminal plugin for Files"
msgstr "Terminal tillegg for Files"

#: data/org.gnome.Terminal.Nautilus.metainfo.xml.in:39
#| msgid "Load a terminal configuration file"
msgid "Open a terminal from Files"
msgstr "Opne ein terminal frå Files"

#: data/org.gnome.Terminal.Nautilus.metainfo.xml.in:41
msgid ""
"Open Terminal is a plugin for the Files application that adds a menu item to "
"the context menu to open a terminal in the currently browsed directory."
msgstr "Open Terminal er eit tillegg for Files-programmet som legg til eit menyval i kontekstmenyen for å opna ein terminal i mappa du no ser på."

#. Translators: This needs to be parsed as a GVariant string, so keep the regular single quotes around the string as-is, and do not add extra quotes.
#: src/org.gnome.Terminal.gschema.xml:133
#| msgid "Unnamed"
msgctxt "visible-name"
msgid "'Unnamed'"
msgstr "'Namnløys'"

#: src/org.gnome.Terminal.gschema.xml:134
msgid "Human-readable name of the profile"
msgstr "Forståeleg namn på profilen"

#: src/org.gnome.Terminal.gschema.xml:135
msgid "Human-readable name of the profile."
msgstr "Forståeleg namn på profilen."

#: src/org.gnome.Terminal.gschema.xml:139
msgid "Default color of text in the terminal"
msgstr "Standard farge på tekst i terminalen"

#: src/org.gnome.Terminal.gschema.xml:140
#| msgid ""
#| "Default color of text in the terminal, as a color specification (can be "
#| "HTML-style hex digits, or a color name such as \"red\")."
msgid ""
"Default color of text in the terminal, as a color specification (can be HTML-"
"style hex digits, or a color name such as “red”)."
msgstr "Standardfarge for tekst i terminalen, som ei fargespesifikasjon (kan vera HTML-stil heksadesimalar, eller eit fargenamn som “raud”)."

#: src/org.gnome.Terminal.gschema.xml:144
msgid "Default color of terminal background"
msgstr "Standard farge på terminalbakgrunnen"

#: src/org.gnome.Terminal.gschema.xml:145
#| msgid ""
#| "Default color of terminal background, as a color specification (can be "
#| "HTML-style hex digits, or a color name such as \"red\")."
msgid ""
"Default color of terminal background, as a color specification (can be HTML-"
"style hex digits, or a color name such as “red”)."
msgstr "Standardfargen på terminalbakgrunnen, som ei fargespesifikasjon (kan vera HTML-stil heksadesimalar, eller eit fargenamn som “raud”)."

#: src/org.gnome.Terminal.gschema.xml:149
#| msgid "Default color of text in the terminal"
msgid "Default color of bold text in the terminal"
msgstr "Standardfargen til fet tekst i terminalen"

#: src/org.gnome.Terminal.gschema.xml:150
#| msgid ""
#| "Default color of text in the terminal, as a color specification (can be "
#| "HTML-style hex digits, or a color name such as \"red\")."
msgid ""
"Default color of bold text in the terminal, as a color specification (can be "
"HTML-style hex digits, or a color name such as “red”). This is ignored if "
"bold-color-same-as-fg is true."
msgstr "Standardfargen til feit tekst i terminalen, som ei fargespesifikasjon (kan vera HTML-stil heksadesimal, eller eit fargenamn som “raud”). Dette blir ikkje brukt dersom bold-color-same-as-fg er sann."

#: src/org.gnome.Terminal.gschema.xml:154
msgid "Whether bold text should use the same color as normal text"
msgstr "Om fet tekst skal bruka same farge som vanleg tekst"

#: src/org.gnome.Terminal.gschema.xml:155
msgid ""
"If true, boldface text will be rendered using the same color as normal text."
msgstr "Om sann, vil fet skrift bli rendera med same farge som vanleg tekst."

#: src/org.gnome.Terminal.gschema.xml:160
msgid ""
"Scale factor for the cell height to increase line spacing. (Does not "
"increase the font’s height.)"
msgstr "Skaleringsfaktor for cellehøgda for å auka linjeavstand. (Aukar ikkje høgda på fonten.)"

#: src/org.gnome.Terminal.gschema.xml:165
msgid ""
"Scale factor for the cell width to increase letter spacing. (Does not "
"increase the font’s width.)"
msgstr "Skaleringsfaktor for cellebreidda for å auke bokstavavstand. (Aukar ikkje breidda på skrifttypen.)"

#: src/org.gnome.Terminal.gschema.xml:169
#| msgid "Whether to blink the cursor"
msgid "Whether to use custom cursor colors"
msgstr "Om du skal bruka eigne markørfargar"

#: src/org.gnome.Terminal.gschema.xml:170
msgid "If true, use the cursor colors from the profile."
msgstr "Om sant, bruk markørfargane frå profilen."

#: src/org.gnome.Terminal.gschema.xml:174
#| msgid "_Background color:"
msgid "Cursor background color"
msgstr "Markør bakgrunnsfarge"

#: src/org.gnome.Terminal.gschema.xml:175
#| msgid ""
#| "Default color of text in the terminal, as a color specification (can be "
#| "HTML-style hex digits, or a color name such as \"red\")."
msgid ""
"Custom color of the background of the terminal’s cursor, as a color "
"specification (can be HTML-style hex digits, or a color name such as “red”). "
"This is ignored if cursor-colors-set is false."
msgstr "Tilpassa farge for bakgrunnen til markøren i terminalen, som ei fargespesifikasjon (kan vera HTML-stil heksadesimalar, eller eit fargenamn som «raud»). Dette blir ikkje brukt dersom cursor-colors-set er false."

#: src/org.gnome.Terminal.gschema.xml:179
msgid "Cursor foreground colour"
msgstr "Markør forgrunnsfarge"

#: src/org.gnome.Terminal.gschema.xml:180
#| msgid ""
#| "Default color of text in the terminal, as a color specification (can be "
#| "HTML-style hex digits, or a color name such as \"red\")."
msgid ""
"Custom color for the foreground of the text character at the terminal’s "
"cursor position, as a color specification (can be HTML-style hex digits, or "
"a color name such as “red”). This is ignored if cursor-colors-set is false."
msgstr "Tilpassa farge for forgrunnen til tekstteiknet ved markøra i terminalen, som ei fargespesifikasjon (kan vera HTML-stil heksadesimalar, eller eit fargenamn som “raud”). Dette blir ikkje brukt dersom cursor-colors-set er false."

#: src/org.gnome.Terminal.gschema.xml:184
msgid "Whether to use custom highlight colors"
msgstr "Om du skal bruka eigne framhevefargar"

#: src/org.gnome.Terminal.gschema.xml:185
msgid "If true, use the highlight colors from the profile."
msgstr "Om sant, bruk markefargane frå profilen."

#: src/org.gnome.Terminal.gschema.xml:189
#| msgid "_Background color:"
msgid "Highlight background color"
msgstr "Markér bakgrunnsfarge"

#: src/org.gnome.Terminal.gschema.xml:190
#| msgid ""
#| "Default color of text in the terminal, as a color specification (can be "
#| "HTML-style hex digits, or a color name such as \"red\")."
msgid ""
"Custom color of the background of the terminal’s highlight, as a color "
"specification (can be HTML-style hex digits, or a color name such as “red”). "
"This is ignored if highlight-colors-set is false."
msgstr "Egendefinert farge for bakgrunnen til terminalens utheving, som ein fargespesifikasjon (kan vera HTML-stil heksadesimal, eller eit fargenamn som «raud»). Dette blir ikkje brukt dersom highlight-colors-set er usann."

#: src/org.gnome.Terminal.gschema.xml:194
msgid "Highlight foreground colour"
msgstr "Markér forgrunnsfarge"

#: src/org.gnome.Terminal.gschema.xml:195
#| msgid ""
#| "Default color of text in the terminal, as a color specification (can be "
#| "HTML-style hex digits, or a color name such as \"red\")."
msgid ""
"Custom color for the foreground of the text character at the terminal’s "
"highlight position, as a color specification (can be HTML-style hex digits, "
"or a color name such as “red”). This is ignored if highlight-colors-set is "
"false."
msgstr "Tilpassa farge for forgrunnen av tekstteiknet ved terminalens highlight-posisjon, som ein fargespesifikasjon (kan vera HTML-stil heksadesimalar, eller eit fargenamn som “raud”). Dette blir ikkje brukt dersom highlight-colors-set er false."

#: src/org.gnome.Terminal.gschema.xml:199
msgid "Whether to perform bidirectional text rendering"
msgstr "Om å utføre tovegs tekstgjengiving"

#: src/org.gnome.Terminal.gschema.xml:200
msgid "If true, perform bidirectional text rendering (“BiDi”)."
msgstr "Om sann, utfør tovegs tekstrendering (“BiDi”)."

#: src/org.gnome.Terminal.gschema.xml:204
msgid "Whether to perform Arabic shaping"
msgstr "Om å utføre arabisk forming"

#: src/org.gnome.Terminal.gschema.xml:205
msgid "If true, shape Arabic text."
msgstr "Om sant, formgje arabisk tekst."

#: src/org.gnome.Terminal.gschema.xml:209
msgid "Whether to enable SIXEL images"
msgstr "Om du skal slå på SIXEL-bilete"

#: src/org.gnome.Terminal.gschema.xml:210
msgid "If true, SIXEL sequences are parsed and images are rendered."
msgstr "Om sant, blir SIXEL-sekvensar tolka og bilete blir rendra."

#: src/org.gnome.Terminal.gschema.xml:214
#| msgid "Whether to allow bold text"
msgid "Whether bold is also bright"
msgstr "Om fet òg er lys"

#: src/org.gnome.Terminal.gschema.xml:215
msgid ""
"If true, setting bold on the first 8 colors also switches to their bright "
"variants."
msgstr "Viss sant, vil innstilling av fet på dei første 8 fargane òg bytte til dei lyse variantane."

#: src/org.gnome.Terminal.gschema.xml:219
#| msgid "Whether to silence terminal bell"
msgid "Whether to ring the terminal bell"
msgstr "Om å ringja terminalklokka"

#: src/org.gnome.Terminal.gschema.xml:223
msgid "List of punctuation characters that are treated as word characters"
msgstr "Liste over teiknsettingstegn som blir behandla som ordteikn"

#: src/org.gnome.Terminal.gschema.xml:224
msgid ""
"By default, when doing word-wise selection, most punctuation breaks up word "
"boundaries. This list of exceptions will instead be treated as part of the "
"word."
msgstr "Som standard, når du gjer ordvis utval, bryt dei fleste teikn opp ordgrenser. Denne lista med unntak vil i staden bli behandla som del av ordet."

#: src/org.gnome.Terminal.gschema.xml:229
msgid "Default number of columns"
msgstr "Standard tal på kolonnar"

#: src/org.gnome.Terminal.gschema.xml:230
msgid ""
"Number of columns in newly created terminal windows. Has no effect if "
"use_custom_default_size is not enabled."
msgstr "_Tal på kolonnar i nyopna terminalvindauge. Har ingen effekt dersom usecustom_default_size ikkje er aktivert."

#: src/org.gnome.Terminal.gschema.xml:235
msgid "Default number of rows"
msgstr "Standard talet på rader"

#: src/org.gnome.Terminal.gschema.xml:236
msgid ""
"Number of rows in newly created terminal windows. Has no effect if "
"use_custom_default_size is not enabled."
msgstr "_Talet på rader i nyopna terminalvindauge. Har ingen verknad dersom usecustom_default_size ikkje er aktivert."

#: src/org.gnome.Terminal.gschema.xml:240
#| msgid "Position of the scrollbar"
msgid "When to show the scrollbar"
msgstr "Når skal rullefeltet visast"

#: src/org.gnome.Terminal.gschema.xml:244
msgid "Number of lines to keep in scrollback"
msgstr "Talet på linjer å ha i rulleminnet"

#: src/org.gnome.Terminal.gschema.xml:245
#| msgid ""
#| "Number of scrollback lines to keep around. You can scroll back in the "
#| "terminal by this number of lines; lines that don't fit in the scrollback "
#| "are discarded. Be careful with this setting; it's the primary factor in "
#| "determining how much memory the terminal will use."
msgid ""
"Number of scrollback lines to keep around. You can scroll back in the "
"terminal by this number of lines; lines that don’t fit in the scrollback are "
"discarded. If scrollback_unlimited is true, this value is ignored."
msgstr "_Talet på scrollback-linjer som skal haldast rundt. Du kan bla tilbake i terminalen med dette talet på linjer; linjer som ikkje får plass i scrollbacken blir kasta. Om scrollbackunlimited er true, blir denne verdien ignorert."

#: src/org.gnome.Terminal.gschema.xml:249
#| msgid "Number of lines to keep in scrollback"
msgid "Whether an unlimited number of lines should be kept in scrollback"
msgstr "Om eit ubegrensa tal på linjer skal haldast i scrollback"

#: src/org.gnome.Terminal.gschema.xml:250
msgid ""
"If true, scrollback lines will never be discarded. The scrollback history is "
"stored on disk temporarily, so this may cause the system to run out of disk "
"space if there is a lot of output to the terminal."
msgstr "Viss dette er sant, vil aldri linjene i scrollback bli kasta. Scrollback-historia blir lagra på disk midlertidig, så dette kan føra til at systemet går tom for diskplass dersom det er mykje utskrift til terminalen."

#: src/org.gnome.Terminal.gschema.xml:254
#| msgid "Whether to scroll to the bottom when a key is pressed"
msgid "Whether to scroll to the bottom when text is inserted"
msgstr "Om du skal bla ned til botnen når tekst blir sett inn"

#: src/org.gnome.Terminal.gschema.xml:255
#| msgid "Whether to scroll to the bottom when a key is pressed"
msgid ""
"If true, the terminal will scroll to the bottom when text is inserted by "
"paste."
msgstr "Om sant, vil terminalen rulle til botnen når tekst blir sett inn med lim inn."

#: src/org.gnome.Terminal.gschema.xml:259
msgid "Whether to scroll to the bottom when a key is pressed"
msgstr "Om terminalen skal rulla til botnen når ein tast vert trykt"

#: src/org.gnome.Terminal.gschema.xml:260
msgid "If true, pressing a key jumps the scrollbar to the bottom."
msgstr "Dersom sann, vil rullefeltet hoppa til botnen ved tastetrykk."

#: src/org.gnome.Terminal.gschema.xml:264
#| msgid "Whether to scroll to the bottom when there's new output"
msgid "Whether to scroll to the bottom when there’s new output"
msgstr "Om du vil bla til botnen når det kjem ny utdata"

#: src/org.gnome.Terminal.gschema.xml:265
#| msgid ""
#| "If true, whenever there's new output the terminal will scroll to the "
#| "bottom."
msgid ""
"If true, whenever there’s new output the terminal will scroll to the bottom."
msgstr "Om sant, vil terminalen rulle til botnen kvar gong det kjem ny utdata."

#: src/org.gnome.Terminal.gschema.xml:269
msgid "What to do with the terminal when the child command exits"
msgstr "Kva skal gjerast med terminalen når barneprosessen avsluttar"

#: src/org.gnome.Terminal.gschema.xml:270
#| msgid ""
#| "Possible values are \"close\" to close the terminal, and \"restart\" to "
#| "restart the command."
msgid ""
"Possible values are “close” to close the terminal, “restart” to restart the "
"command, and “hold” to keep the terminal open with no command running inside."
msgstr "Moglege verdiar er “close” for å lukka terminalen, “restart” for å starte på nytt kommandoen, og “hold” for å halda terminalen open utan at noka kommando køyrer inni."

#: src/org.gnome.Terminal.gschema.xml:274
msgid "Whether to launch the command in the terminal as a login shell"
msgstr "Om kommandoen i terminalen skal startast som eit påloggingsskal"

#: src/org.gnome.Terminal.gschema.xml:275
#| msgid ""
#| "If true, the command inside the terminal will be launched as a login "
#| "shell. (argv[0] will have a hyphen in front of it.)"
msgid ""
"If true, the command inside the terminal will be launched as a login shell "
"(argv[0] will have a hyphen in front of it)."
msgstr "Om sann, vert kommandoa inne i terminalen starta som ein login-shell (argv[0] får eit bindestrek framfor seg)."

#: src/org.gnome.Terminal.gschema.xml:279
#| msgid "Whether to update login records when launching terminal command"
msgid "Whether to preserve the working directory when opening a new terminal"
msgstr "Om å halda på arbeidskatalogen når du opnar ein ny terminal"

#: src/org.gnome.Terminal.gschema.xml:280
msgid ""
"Controls when opening a new terminal from a previous one carries over the "
"working directory of the opening terminal to the new one."
msgstr "Controls når du opnar eit nytt terminal frå eit tidlegare, gjer at arbeidskatalogen til det tidlegare terminalet blir overført til det nye."

#: src/org.gnome.Terminal.gschema.xml:286
msgid "Whether to run a custom command instead of the shell"
msgstr "Om det skal køyrast ein eigendefinert kommando i staden for skalet"

#: src/org.gnome.Terminal.gschema.xml:287
msgid ""
"If true, the value of the custom_command setting will be used in place of "
"running a shell."
msgstr ""
"Dersom sann, vil verdien til «custom_command» verta køyrt i staden for eit "
"skal."

#: src/org.gnome.Terminal.gschema.xml:291
msgid "Whether to blink the cursor"
msgstr "Om markøren skal blinka"

#: src/org.gnome.Terminal.gschema.xml:292
#| msgid ""
#| "The possible values are \"system\" to use the global cursor blinking "
#| "settings, or \"on\" or \"off\" to set the mode explicitly."
msgid ""
"The possible values are “system” to use the global cursor blinking settings, "
"or “on” or “off” to set the mode explicitly."
msgstr "Moglege verdiar er “system” for å bruka dei globale innstillingane for blinking av markør, eller “on” eller “off” for å setja modusen eksplisitt."

#: src/org.gnome.Terminal.gschema.xml:296
msgid "The cursor appearance"
msgstr "Korleis markøren ser ut"

#: src/org.gnome.Terminal.gschema.xml:300
msgid ""
"Possible values are “always” or “never” allow blinking text, or only when "
"the terminal is “focused” or “unfocused”."
